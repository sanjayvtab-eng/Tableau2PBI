<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2020.4.0 (20204.20.1126.1328)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='MySQL_Sales_Source' name='MySQL_Sales_Source'>
      <!-- Row-level calculations -->
      <column caption='Profit' datatype='real' name='[Profit]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SalesAmount] - [CostAmount]' />
      </column>
      <column caption='Net Sales' datatype='real' name='[Net Sales]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SalesAmount] - [DiscountAmount]' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Profit Margin]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [SalesAmount] = 0 THEN 0 ELSE [Profit] / [SalesAmount] END' />
      </column>
      <column caption='High Value Sale' datatype='string' name='[High Value Sale]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SalesAmount] &gt;= 10000 THEN &quot;High Value&quot; ELSE &quot;Standard&quot; END' />
      </column>
      <column caption='Sales Category' datatype='string' name='[Sales Category]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SalesAmount] &gt;= 50000 THEN &quot;Enterprise&quot; ELSEIF [SalesAmount] &gt;= 10000 THEN &quot;Commercial&quot; ELSE &quot;Retail&quot; END' />
      </column>
      <column caption='Discount Percentage' datatype='real' name='[Discount Percentage]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [SalesAmount] = 0 THEN 0 ELSE [DiscountAmount] / [SalesAmount] END' />
      </column>
      <column caption='Product Performance' datatype='string' name='[Product Performance]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &gt; 10000 THEN &quot;Excellent&quot; ELSEIF [Profit] &gt; 5000 THEN &quot;Good&quot; ELSEIF [Profit] &gt; 0 THEN &quot;Low Profit&quot; ELSE &quot;Loss&quot; END' />
      </column>
      <column caption='Order Year' datatype='integer' name='[Order Year]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [OrderDate])' />
      </column>
      <column caption='Order Month' datatype='string' name='[Order Month]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [OrderDate])' />
      </column>
      <column caption='Order Quarter' datatype='string' name='[Order Quarter]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [OrderDate]))' />
      </column>

      <!-- Aggregate Measures -->
      <column caption='Total Sales' datatype='real' name='[Total Sales]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SalesAmount])' />
      </column>
      <column caption='Total Cost' datatype='real' name='[Total Cost]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([CostAmount])' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Total Profit]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SalesAmount]) - SUM([CostAmount])' />
      </column>
      <column caption='Average Sales' datatype='real' name='[Average Sales]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([SalesAmount])' />
      </column>
      <column caption='Total Quantity' datatype='integer' name='[Total Quantity]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity])' />
      </column>
      <column caption='Total Discount' datatype='real' name='[Total Discount]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([DiscountAmount])' />
      </column>
      <column caption='Sales Target' datatype='real' name='[Sales Target]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TargetAmount])' />
      </column>
      <column caption='Sales Variance' datatype='real' name='[Sales Variance]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SalesAmount]) - SUM([TargetAmount])' />
      </column>
      <column caption='Target Achievement Percentage' datatype='real' name='[Target Achievement Percentage]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([TargetAmount]) = 0 THEN 0 ELSE SUM([SalesAmount]) / SUM([TargetAmount]) END' />
      </column>
    </datasource>
  </datasources>
  <relationships>
    <relationship class='cross-datasource' cross-filter-direction='single' type='many-to-one'>
      <expression op='='>
        <expression op='[MySQL_Sales_Source].[CustomerID]' />
        <expression op='[MySQL_Sales_Source].[CustomerID]' />
      </expression>
    </relationship>
  </relationships>
</workbook>
